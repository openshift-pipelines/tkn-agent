    {
      "id": "yamllint/run-yamllint",
      "script_path": "ci/images/static-checks/content/bin/yamllint.sh",
      "configuration": "ci/images/static-checks/content/config/yamllint.yaml",
      "command": "ci/images/static-checks/content/bin/yamllint.sh --config-file ./ci/images/static-checks/content/config/yamllint.yaml --workspace_dir .",
      "mutation": {
        "path": "tkn-agent-eval-duplicate.yaml",
        "content": "---\nevaluation:\n  enabled: true\n  enabled: false\n",
        "expected_diagnostic": "key-duplicates",
        "expected_exit": "nonzero",
        "repair": "---\nevaluation:\n  enabled: true\n"
      }
    }
  ],
  "component_replay_adaptations": [
